{
  "name": "miri-shell",
  "version": "0.1.0",
  "description": "Custom Linux desktop shell and file explorer for Hyprland built with AGS (Astal)",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:bar",
    "dev:bar": "PATH=\"$PWD/node_modules/.bin:$PATH\" GI_TYPELIB_PATH=\"/usr/local/lib64/girepository-1.0:/usr/local/lib/girepository-1.0:${GI_TYPELIB_PATH:-}\" LD_LIBRARY_PATH=\"/usr/local/lib64:/usr/local/lib:${LD_LIBRARY_PATH:-}\" ags run top-bar/app.ts",
    "dev:files": "PATH=\"$PWD/node_modules/.bin:$PATH\" GI_TYPELIB_PATH=\"/usr/local/lib64/girepository-1.0:/usr/local/lib/girepository-1.0:${GI_TYPELIB_PATH:-}\" LD_LIBRARY_PATH=\"/usr/local/lib64:/usr/local/lib:${LD_LIBRARY_PATH:-}\" ags run file-explorer/app.ts",
    "bundle:bar": "PATH=\"$PWD/node_modules/.bin:$PATH\" GI_TYPELIB_PATH=\"/usr/local/lib64/girepository-1.0:/usr/local/lib/girepository-1.0:${GI_TYPELIB_PATH:-}\" LD_LIBRARY_PATH=\"/usr/local/lib64:/usr/local/lib:${LD_LIBRARY_PATH:-}\" ags bundle top-bar/app.ts dist/miri-topbar",
    "bundle:files": "PATH=\"$PWD/node_modules/.bin:$PATH\" GI_TYPELIB_PATH=\"/usr/local/lib64/girepository-1.0:/usr/local/lib/girepository-1.0:${GI_TYPELIB_PATH:-}\" LD_LIBRARY_PATH=\"/usr/local/lib64:/usr/local/lib:${LD_LIBRARY_PATH:-}\" ags bundle file-explorer/app.ts dist/miri-files",
    "quit": "ags quit"
  },
  "dependencies": {
    "ags": "*",
    "gnim": "*",
    "lucide-static": "^1.37.0"
  },
  "devDependencies": {
    "sass": "^1.103.1"
  }
}
